<!DOCTYPE html>
<html lang="id">
<head>
    <title>Register Siswa - Sipeka</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light py-5">
    <div class="container" style="max-width: 500px;">
        <div class="card shadow p-4">
            <h3 class="text-center mb-3">Registrasi Akun Siswa</h3>
            <form action="/register" method="POST">
                <div class="mb-3"><label>Nama Lengkap</label><input type="text" name="nama" class="form-control" required></div>
                <div class="mb-3"><label>Email</label><input type="email" name="email" class="form-control" required></div>
                <div class="mb-3"><label>Password</label><input type="password" name="password" class="form-control" required></div>
                <div class="mb-3"><label>Kelas</label><input type="text" name="kelas" class="form-control" placeholder="Contoh: XII RPL 1" required></div>
                <div class="mb-3"><label>Tempat PKL (Nama DU/DI)</label><input type="text" name="tempatPkl" class="form-control" required></div>
                <div class="mb-3">
                    <label>Guru Pembimbing</label>
                    <select name="guruPembimbing" class="form-control" required>
    <% if (gurus && gurus.length > 0) { %>
        <% gurus.forEach(g => { %>
            <option value="<%= g.id %>"><%= g.nama %></option>
        <% }) %>
    <% } else { %>
        <option value="">Data guru belum tersedia</option>
    <% } %>
</select>
                </div>
                <button type="submit" class="btn btn-success w-100">Daftar</button>
            </form>
            <div class="text-center mt-3"><small>Sudah punya akun? <a href="/login">Login</a></small></div>
        </div>
    </div>
</body>
</html>