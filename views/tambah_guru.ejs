<!DOCTYPE html>
<html lang="id">
<head>
    <title>Tambah Guru - Sipeka</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow p-4">
                    <h3 class="mb-3 text-center">Tambah Guru Pembimbing Baru</h3>
                    <form action="/admin/tambah-guru" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Nama Lengkap & Gelar</label>
                            <input type="text" name="nama" class="form-control" placeholder="Contoh: Budi Santoso, M.Pd." required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email Guru (Untuk Login)</label>
                            <input type="email" name="email" class="form-control" placeholder="budi@gmail.com" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" name="password" class="form-control" placeholder="Password akun" required>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a href="/dashboard/guru" class="btn btn-secondary">Kembali</a>
                            <button type="submit" class="btn btn-primary">Simpan Guru Baru</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>